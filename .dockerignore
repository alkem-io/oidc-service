# Exclude version control metadata
.git
.gitignore

# Node and package manager artefacts (monorepo safety)
node_modules/
pnpm-lock.yaml
yarn.lock
package-lock.json

# Build outputs and caches
bin/
dist/
build/
coverage/
.tmp/

# Environment and secret files
.env*

# Documentation and local tooling not needed in image
docs/
test/
.specify/
.github/
