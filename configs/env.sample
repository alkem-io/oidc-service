## Sample environment configuration for the OIDC service

## Core (always required)
# Internal URLs for Ory services (inside Docker network / cluster)
OIDC_HYDRA_ADMIN_URL=http://hydra:4445
OIDC_KRATOS_ADMIN_URL=http://kratos:4434
OIDC_KRATOS_PUBLIC_URL=http://kratos:4433
OIDC_ALKEMIO_SERVER_URL=http://alkemio-server:3000
# OIDC_ALKEMIO_IDENTITY_RESOLVE_PATH=/rest/internal/identity/resolve
# OIDC_ALKEMIO_IDENTITY_TIMEOUT=30s
# OIDC_ALKEMIO_IDENTITY_RETRIES=5

## Database (optional, enables fast DB-first identity resolution)
# When configured, the service queries the Alkemio database directly for identity
# mappings before falling back to the HTTP API. Improves performance and reduces
# load on the Alkemio server.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=synapse
DATABASE_PASSWORD=synapse
DATABASE_NAME=alkemio
# DATABASE_TIMEOUT=5s

# Public origin for building absolute return URLs (e.g., Traefik at :3000 in dev)
# Default return base becomes ${OIDC_WEB_BASE_URL}/oidc/login
OIDC_WEB_BASE_URL=http://localhost:3000

## Optional (sane defaults; only set when you need to override)
# Browser-facing Kratos base for redirects; if unset, the service uses X-Forwarded-Proto/Host
# provided by the reverse proxy to build public URLs safely.
# OIDC_KRATOS_BROWSER_URL=https://auth.example.com

# Explicitly override the return base; by default derived from OIDC_WEB_BASE_URL
# OIDC_LOGIN_RETURN_BASE_URL=https://app.example.com/oidc/login

# Admin bearer token for maintenance endpoints (optional)
# OIDC_ADMIN_TOKEN=

## Operational toggles
# Allow http scheme for local/dev; keep false for production
OIDC_ALLOW_INSECURE_HTTP=true
OIDC_MAINTENANCE_MODE=false
OIDC_MAINTENANCE_RETRY=0
OIDC_READINESS_TIMEOUT=5s
OIDC_LOG_LEVEL=info
