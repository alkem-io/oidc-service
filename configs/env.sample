# Sample environment configuration for the OIDC service
OIDC_HYDRA_ADMIN_URL=https://hydra-admin.local
OIDC_KRATOS_ADMIN_URL=https://kratos-admin.local
OIDC_KRATOS_PUBLIC_URL=https://kratos-public.local
OIDC_ADMIN_TOKEN=
OIDC_ALLOW_INSECURE_HTTP=false
OIDC_MAINTENANCE_MODE=false
OIDC_MAINTENANCE_RETRY=0
OIDC_READINESS_TIMEOUT=5s
OIDC_LOG_LEVEL=info
